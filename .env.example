# ============================================================
# 必填
# ============================================================

# 飞书自定义机器人 webhook 地址（在飞书群「设置 → 添加机器人」里拿到）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/你的webhook地址

# AI 大模型密钥（本项目默认用 Agnes AI，免费）
AI_API_KEY=你的API_KEY


# ============================================================
# 选填：抓 X（推特）
# ============================================================
# 不填 → 自动跳过 X，其它内容源照常工作，不会报错。
#
# 怎么拿这两个值（浏览器登录 x.com 之后）：
#   1. 按 F12 打开开发者工具 → 顶部选 Application（应用）标签
#   2. 左侧 Storage → Cookies → https://x.com
#   3. 找到 auth_token 和 ct0 两行，各复制它们的 Value
#   4. 按下面格式拼成一行 JSON 填进来
#
# 注意：这两个值等同于你的登录态，切勿泄露、切勿提交到 GitHub。
# 有效期通常几个月，过期后 X 抓取会返回 0 条，重新复制一次即可。
# TWITTER_COOKIES={"auth_token":"你的auth_token","ct0":"你的ct0"}


# ============================================================
# 选填：读取「👍想做 / 👎没兴趣」反馈
# ============================================================
# 不填也能用：公开仓库的 Issues 匿名也读得到，只是每小时限 60 次请求。
# 填了额度提到 5000 次/小时，更稳。
# 生成方式：GitHub → Settings → Developer settings → Personal access tokens
#          → Fine-grained token，仓库只勾选本项目，权限只给 Issues: Read-only
# GITHUB_TOKEN=github_pat_xxx


# ============================================================
# 选填：覆盖 config.yaml 的默认值
# ============================================================
# AI_API_BASE=https://apihub.agnes-ai.com/v1
# AI_MODEL=agnes-2.5-flash
# WEIXIN_RSS_BASE_URL=   # 部署 WeWe-RSS 后填其 /feeds/all.rss 的公网地址
