# 飞书自定义机器人 webhook 地址（在飞书群「设置 → 添加机器人」里拿到）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/你的webhook地址

# AI 大模型密钥（本项目默认用 Agnes AI，免费）
AI_API_KEY=你的API_KEY

# 以下为可选覆盖项，不填则用 config.yaml 的默认值
# AI_API_BASE=https://apihub.agnes-ai.com/v1
# AI_MODEL=agnes-2.5-flash
# WEIXIN_RSS_BASE_URL=   # 部署 WeWe-RSS 后填其 /feeds/all.rss 的公网地址
